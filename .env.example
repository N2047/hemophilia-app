# Database Configuration
# Production PostgreSQL:
DATABASE_URL="postgresql://username:password@localhost:5432/hemophilia_db?schema=public"

# Authentication Security (Use a 256-bit secure random key)
JWT_SECRET="replace-with-a-very-strong-production-secret-key-32-chars-minimum"
SESSION_MAX_AGE_SECONDS=28800

# Inventory Alert Thresholds
LOW_STOCK_THRESHOLD=10
EXPIRY_ALERT_DAYS=90

# Application Environment
NODE_ENV="production"
PORT=3000
